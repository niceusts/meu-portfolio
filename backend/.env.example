DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

PORT=3333
FRONTEND_URL="http://localhost:3000"

# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_xxx"
